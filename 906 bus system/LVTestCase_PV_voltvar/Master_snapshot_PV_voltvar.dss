clear

! Snapshot master for LVTestCase + Volt-Var PVs @ 906.1 and 639.2 (copy + add-on).
! Stock original under IEEETestCases/LVTestCase is NOT modified.

Set DefaultBaseFrequency=50

New circuit.LVTest
Edit Vsource.Source BasekV=11 pu=1.05  ISC3=3000  ISC1=5
Redirect LineCode.txt
Redirect LoadShapes.txt
batchedit loadshape..* useactual=no
Redirect Lines.txt
Redirect Transformers.txt
Redirect Loads.txt
Redirect Monitors.txt
Redirect PV_voltvar_906.dss

New energymeter.m1 LINE.LINE1 1

Set voltagebases=[11  .416]
Calcvoltagebases

buscoords buscoords.txt

Set Mode=Snapshot
! STATIC lets InvControl Volt-Var settle each solve
Set ControlMode=STATIC
Set Number=1
Set Hour=0
Set Sec=0
Set LoadMult=1
solve
