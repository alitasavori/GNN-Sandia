!----------------------------------------------------------------------------------------------------------------------------
! IEEE 8500-node DAILY setup entrypoint (balanced case)
!  - 5-minute resolution profile definition
!  - Shared setup for Python daily workflows (OpenDSS + ML comparisons)
!  - Does NOT execute Solve; caller controls per-step solve timing
!----------------------------------------------------------------------------------------------------------------------------

Compile (Master.dss)

! Define daily loadshape from CSV in 8500-node folder.
New Loadshape.Day5min npts=288 interval=0.0833333333333333 mult=(file=5minDayShape.csv, col=2, header=no)

! Apply to every load object.
BatchEdit Load..* Daily=Day5min

Set maxiterations=20
Set mode=daily
Set stepsize=5m
Set number=288

New Energymeter.m1 Line.ln5815900-1 1
