    "import os\n",
    "try:\n",
    "    import run_injection_dataset as _inj\n",
    "    os.chdir(os.path.dirname(os.path.abspath(_inj.__file__)))\n",
    "except Exception:\n",
    "    pass\n",
    "exec(open(\"run_deltav_dataset.py\", encoding=\"utf-8\").read())"
   ]
