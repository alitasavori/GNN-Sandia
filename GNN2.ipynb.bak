   "source": [
    "# Plot PV P/Q (Volt-Var), load P/Q, and capacitor Q (nominal + post-solve) at a chosen node over 24h\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "import run_injection_dataset as inj\n",
    "import run_loadtype_dataset as lt\n",
    "from run_gnn3_overlay_7 import (\n",
    "    P_BASE, Q_BASE, PV_BASE, STEP_MIN, NPTS,\n",
    "    get_all_node_voltage_pu_and_angle_dict,\n",
    "    find_loadshape_csv_in_dss,\n",
    "    resolve_csv_path,\n",
    "    read_profile_csv_two_col_noheader,\n",
    ")\n",
    "\n",
    "dss = inj.dss  # shorthand\n",
    "\n",
    "# Node with Volt-Var PV: use '850.1'\n",
    "obs_node = \"850.2\"   # change if you want another bus.phase\n",
    "bus_obs, ph_obs = obs_node.split(\".\")\n",
    "ph_obs = int(ph_obs)\n",
    "\n",
    "# Compile DSS and set up daily profiles\n",
    "dss_path = inj.compile_once()\n",
    "inj.setup_daily()\n",
    "\n",
    "csvL_token, _ = find_loadshape_csv_in_dss(dss_path, \"5minDayShape\")\n",
    "csvPV_token, _ = find_loadshape_csv_in_dss(dss_path, \"IrradShape\")\n",
    "mL = read_profile_csv_two_col_noheader(resolve_csv_path(csvL_token, dss_path), npts=NPTS)\n",
    "mPV = read_profile_csv_two_col_noheader(resolve_csv_path(csvPV_token, dss_path), npts=NPTS)\n",
    "\n",
    "node_names_master, _, _, bus_to_phases = inj.get_all_bus_phase_nodes()\n",
    "loads_dss, dev_to_dss_load, dev_to_busph_load = inj.build_load_device_maps(bus_to_phases)\n",
    "pv_dss, pv_to_dss, pv_to_busph = inj.build_pv_device_maps()\n",
    "\n",
    "P_load_series, Q_load_series = [], []\n",
    "P_pv_series, Q_pv_series = [], []\n",
    "Q_cap_nom_series, Q_cap_actual_series = [], []\n",
    "V_series = []\n",
    "\n",
    "time_hours = np.arange(NPTS) * STEP_MIN / 60.0\n",
    "rng_det = np.random.default_rng(0)\n",
    "\n",
    "\n",
    "def get_cap_q_actual_by_busph():\n",
    "    \"\"\"Read post-solve capacitor Q per bus.phase using DSS TotalPowers().\"\"\"\n",
    "    busphQ_cap = {}\n",
    "    dss.Capacitors.First()\n",
    "    while True:\n",
    "        name = dss.Capacitors.Name()\n",
    "        if not name:\n",
    "            break\n",
    "\n",
    "        # Make this capacitor the active element\n",
    "        dss.Circuit.SetActiveElement(f\"Capacitor.{name}\")\n",
    "\n",
    "        # TotalPowers: [P_total, Q_total, ...], generation is negative\n",
    "        pwr = dss.CktElement.TotalPowers()\n",
    "        if len(pwr) >= 2:\n",
    "            Q_tot = -float(pwr[1])  # injection convention: + = into feeder\n",
    "        else:\n",
    "            Q_tot = 0.0\n",
    "\n",
    "        # Get bus and phases from BusNames()[0]\n",
    "        busnames = dss.CktElement.BusNames()\n",
    "        bus_full = busnames[0] if busnames else \"\"\n",
    "        bus, phs = inj.parse_bus_spec(bus_full)\n",
    "        if not phs:\n",
    "            phs = [1, 2, 3]\n",
    "\n",
    "        share = Q_tot / len(phs) if phs else 0.0\n",
    "        for ph in phs:\n",
    "            busphQ_cap[(bus, ph)] = busphQ_cap.get((bus, ph), 0.0) + share\n",
    "\n",
    "        if not dss.Capacitors.Next():\n",
    "            break\n",
    "\n",
    "    return busphQ_cap\n",
    "\n",
    "\n",
    "for t in range(NPTS):\n",
    "    inj.set_time_index(t)\n",
    "    # Apply snapshot at baseline totals (no noise)\n",
    "    _, busphP_load, busphQ_load, busphP_pv_nom, busphQ_pv_nom, _ = lt._apply_snapshot_with_per_type(\n",
    "        P_load_total_kw=P_BASE, Q_load_total_kvar=Q_BASE, P_pv_total_kw=PV_BASE,\n",
    "        mL_t=float(mL[t]), mPV_t=float(mPV[t]),\n",
    "        loads_dss=loads_dss, dev_to_dss_load=dev_to_dss_load, dev_to_busph_load=dev_to_busph_load,\n",
    "        pv_dss=pv_dss, pv_to_dss=pv_to_dss, pv_to_busph=pv_to_busph,\n",
    "        sigma_load=0.0, sigma_pv=0.0, rng=rng_det,\n",
    "    )\n",
    "\n",
    "    dss.Solution.Solve()\n",
    "    if not dss.Solution.Converged():\n",
    "        P_load_series.append(np.nan)\n",
    "        Q_load_series.append(np.nan)\n",
    "        P_pv_series.append(np.nan)\n",
    "        Q_pv_series.append(np.nan)\n",
    "        Q_cap_nom_series.append(np.nan)\n",
    "        Q_cap_actual_series.append(np.nan)\n",
    "        V_series.append(np.nan)\n",
    "        continue\n",
    "\n",
    "    # Load P/Q at obs_node (snapshot values)\n",
    "    P_load = float(busphP_load.get((bus_obs, ph_obs), 0.0))\n",
    "    Q_load = float(busphQ_load.get((bus_obs, ph_obs), 0.0))\n",
    "\n",
    "    # PV actual P/Q at obs_node (post-solve, includes Volt-Var)\n",
    "    busphP_pv_actual, busphQ_pv_actual = inj.get_pv_actual_pq_by_busph(pv_to_dss, pv_to_busph)\n",
    "    P_pv = float(busphP_pv_actual.get((bus_obs, ph_obs), 0.0))\n",
    "    Q_pv = float(busphQ_pv_actual.get((bus_obs, ph_obs), 0.0))\n",
    "\n",
    "    # Capacitor reactive injection: nominal vs post-solve\n",
    "    Q_cap_nom = float(inj.cap_q_kvar_per_node(bus_obs, ph_obs))\n",
    "    busphQ_cap_actual = get_cap_q_actual_by_busph()\n",
    "    Q_cap_actual = float(busphQ_cap_actual.get((bus_obs, ph_obs), 0.0))\n",
    "\n",
    "    # Voltage at obs_node\n",
    "    vdict = get_all_node_voltage_pu_and_angle_dict()\n",
    "    vm_obs, _ = vdict.get(obs_node, (np.nan, 0.0))\n",
    "\n",
    "    P_load_series.append(P_load)\n",
    "    Q_load_series.append(Q_load)\n",
    "    P_pv_series.append(P_pv)\n",
    "    Q_pv_series.append(Q_pv)\n",
    "    Q_cap_nom_series.append(Q_cap_nom)\n",
    "    Q_cap_actual_series.append(Q_cap_actual)\n",
    "    V_series.append(float(vm_obs))\n",
    "\n",
    "P_load_series = np.array(P_load_series, float)\n",
    "Q_load_series = np.array(Q_load_series, float)\n",
    "P_pv_series = np.array(P_pv_series, float)\n",
    "Q_pv_series = np.array(Q_pv_series, float)\n",
    "Q_cap_nom_series = np.array(Q_cap_nom_series, float)\n",
    "Q_cap_actual_series = np.array(Q_cap_actual_series, float)\n",
    "V_series = np.array(V_series, float)\n",
    "\n",
    "fig, axes = plt.subplots(3, 1, figsize=(10, 10), sharex=True)\n",
    "\n",
    "axes[0].plot(time_hours, V_series, \"b-\", lw=1.5)\n",
    "axes[0].set_ylabel(\"|V| (pu)\")\n",
    "axes[0].set_title(f\"Voltage magnitude @ {obs_node}\")\n",
    "axes[0].grid(True)\n",
    "\n",
    "axes[1].plot(time_hours, P_load_series, label=\"P_load (kW)\", color=\"tab:blue\")\n",
    "axes[1].plot(time_hours, Q_load_series, label=\"Q_load (kVAR)\", color=\"tab:orange\")\n",
    "axes[1].plot(time_hours, Q_cap_nom_series, label=\"Q_cap_nom (kVAR)\", color=\"tab:green\", linestyle=\"--\")\n",
    "axes[1].plot(time_hours, Q_cap_actual_series, label=\"Q_cap_actual (kVAR)\", color=\"tab:red\", linestyle=\":\")\n",
    "axes[1].set_ylabel(\"Load / Cap Q\")\n",
    "axes[1].set_title(f\"Load P/Q and capacitor Q @ {obs_node}\")\n",
    "axes[1].legend()\n",
    "axes[1].grid(True)\n",
    "\n",
    "axes[2].plot(time_hours, P_pv_series, label=\"P_pv_actual (kW)\", color=\"tab:green\")\n",
    "axes[2].plot(time_hours, Q_pv_series, label=\"Q_pv_actual (kVAR)\", color=\"tab:red\")\n",
    "axes[2].set_xlabel(\"Hour of day\")\n",
    "axes[2].set_ylabel(\"PV P/Q\")\n",
    "axes[2].set_title(f\"PV actual P/Q @ {obs_node} (Volt-Var)\")\n",
    "axes[2].legend()\n",
    "axes[2].grid(True)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
