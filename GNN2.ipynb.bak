   "source": [
    "\n",
    "# Two-model daily comparison: report worst nodes + one plot per node (OpenDSS + 2 models)\n",
    "# Runs comparison in subprocess (avoids torch import in notebook) then loads results and plots inline\n",
    "import subprocess\n",
    "import sys\n",
    "import pickle\n",
    "import tempfile\n",
    "import os\n",
    "import matplotlib.pyplot as plt\n",
    "from IPython.display import display, Image\n",
    "\n",
    "ckpt1 = \"models_gnn2/original_plus_cap/light_wide_emb_depth3_search_best.pt\"\n",
    "\n",
    "#ckpt1 = \"models_gnn2/original/light_xwide_emb_depth4_best.pt\"\n",
    "#ckpt1 = \"models_gnn2/original/ckpt_original.pt\"\n",
    "ckpt2 = \"gnn2_architecture_search/original/best.pt\"\n",
    "\n",
    "\n",
    "#ckpt2 = \"models_gnn2/injection/wide_shallow_h160_depth3_best.pt\"\n",
    "#ckpt2 = \"gnn2_architecture_search/injection/best.pt\"\n",
    "\n",
    "\n",
    "#ckpt2 = \"models_gnn2/loadtype/light_emb_h96_phase_onehot_depth3_h112_no_global_best.pt\"\n",
    "\n",
    "#ckpt1 = \"models_gnn2/loadtype/light_h96_depth2_noemb_best.pt\"\n",
    "\n",
    "#ckpt2 = \"models_gnn2/loadtype/light_emb_h96_phase_onehot_depth3_h112_best.pt\"\n",
    "#ckpt1 = \"models_gnn2/loadtype/light_emb_h96_phase_onehot_depth3_h112_weighted_loss_best.pt\"\n",
    "#ckpt2 = \"gnn2_architecture_search/loadtype/best.pt\"\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "nodes_to_plot = [\"840.1\", \"848.3\", \"890.1\"]\n",
    "top_k = 0\n",
    "\n",
    "with tempfile.NamedTemporaryFile(suffix=\".pkl\", delete=False) as f:\n",
    "    pkl_path = f.name\n",
    "try:\n",
    "    r = subprocess.run([sys.executable, \"compare_two_models_daily.py\", ckpt1, ckpt2,\n",
    "        \"--nodes\"] + nodes_to_plot + [\"--top-k\", str(top_k), \"--no-save-png\", \"--save-results\", pkl_path],\n",
    "        capture_output=True, text=True, cwd=os.getcwd())\n",
    "    if r.returncode != 0:\n",
    "        print(\"STDOUT:\", r.stdout or \"(none)\")\n",
    "        print(\"STDERR:\", r.stderr or \"(none)\")\n",
    "        raise SystemExit(r.returncode)\n",
    "    with open(pkl_path, \"rb\") as f:\n",
    "        data = pickle.load(f)\n",
    "    # Pickle: (t_hours, node_names, V_dss, V_1, V_2, df_mae, label_1, label_2, worst_indices, summary_dict)\n",
    "    if len(data) == 10:\n",
    "        t_hours, node_names, V_dss, V_1, V_2, df_mae, label_1, label_2, worst_indices, summary = data\n",
    "    else:\n",
    "        t_hours, node_names, V_dss, V_1, V_2, df_mae, label_1, label_2, worst_indices = data\n",
    "        summary = {}\n",
    "finally:\n",
    "    if os.path.exists(pkl_path):\n",
    "        os.remove(pkl_path)\n",
    "\n",
    "node_to_idx = {n: i for i, n in enumerate(node_names)}\n",
    "\n",
    "# Overall metrics (training from checkpoint + this run single-day)\n",
    "if summary:\n",
    "    print(\"\\nTraining (test set, from checkpoint):\")\n",
    "    for i, lab in enumerate([label_1, label_2], 1):\n",
    "        tm, tr, te = summary.get(f\"train_mae_{i}\"), summary.get(f\"train_rmse_{i}\"), summary.get(f\"train_epoch_{i}\")\n",
    "        if tm is not None and tr is not None:\n",
    "            ep = f\" (epoch {te})\" if te is not None else \"\"\n",
    "            print(f\"  {lab}:  MAE = {float(tm):.5f} pu   RMSE = {float(tr):.5f} pu{ep}\")\n",
    "        else:\n",
    "            print(f\"  {lab}:  (not in checkpoint)\")\n",
    "    print(\"\\nThis run (single 24h day, all nodes):\")\n",
    "    print(f\"  {label_1}:  MAE = {summary['mae_1']:.5f} pu   RMSE = {summary['rmse_1']:.5f} pu\")\n",
    "    print(f\"  {label_2}:  MAE = {summary['mae_2']:.5f} pu   RMSE = {summary['rmse_2']:.5f} pu\")\n",
    "\n",
    "# Report: nodes where the two models differ most\n",
    "n_show = len(worst_indices) if top_k == 0 else top_k\n",
    "print(\"\\n\" + \"=\" * 72)\n",
    "print(f\"Worst {n_show} nodes by |MAE({label_1}) - MAE({label_2})|\")\n",
    "print(\"=\" * 72)\n",
    "for k, idx in enumerate(worst_indices):\n",
    "    n = node_names[idx]\n",
    "    m1, m2 = df_mae.loc[df_mae[\"node\"] == n, [\"mae_1\", \"mae_2\"]].iloc[0]\n",
    "    d = float(df_mae.loc[df_mae[\"node\"] == n, \"mae_diff\"].iloc[0])\n",
    "    print(f\"  {k+1}. {n}: {label_1} MAE={m1:.4f} | {label_2} MAE={m2:.4f} | diff={d:.4f}\")\n",
    "print(\"=\" * 72)\n",
    "\n",
    "# One plot per node: requested nodes + worst nodes (no duplicates)\n",
    "plot_indices = []\n",
    "for n in nodes_to_plot:\n",
    "    if n in node_to_idx and node_to_idx[n] not in plot_indices:\n",
    "        plot_indices.append(node_to_idx[n])\n",
    "for idx in worst_indices:\n",
    "    if idx not in plot_indices:\n",
    "        plot_indices.append(idx)\n",
    "\n",
    "for idx in plot_indices:\n",
    "    n = node_names[idx]\n",
    "    m1, m2 = df_mae.loc[df_mae[\"node\"] == n, [\"mae_1\", \"mae_2\"]].iloc[0].values\n",
    "    fig, ax = plt.subplots(figsize=(10, 5))\n",
    "    ax.plot(t_hours, V_dss[:, idx], \"b-\", label=\"OpenDSS |V| (pu)\", linewidth=2)\n",
    "    ax.plot(t_hours, V_1[:, idx], color=\"orange\", linestyle=\"--\", label=f\"{label_1} (MAE={m1:.4f})\", linewidth=1.5)\n",
    "    ax.plot(t_hours, V_2[:, idx], \"g:\", label=f\"{label_2} (MAE={m2:.4f})\", linewidth=1.5)\n",
    "    ax.set_xlabel(\"Hour of day\")\n",
    "    ax.set_ylabel(\"Voltage magnitude (pu)\")\n",
    "    ax.set_title(f\"24h voltage @ {n}\")\n",
    "    ax.grid(True)\n",
    "    ax.legend()\n",
    "    plt.tight_layout()\n",
    "    _path = f\"_temp_plot_{n.replace('.', '_')}.png\"\n",
    "    fig.savefig(_path, dpi=150, bbox_inches=\"tight\")\n",
    "    plt.close(fig)\n",
    "    print(f'Node: {n}')\n",
    "    display(Image(_path))"
   ]
  },
