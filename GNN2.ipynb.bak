    "# ============================================================\n",
    "# RUN (delegated to external script)\n",
    "# ============================================================\n",
    "import os\n",
    "# Ensure cwd is repo root so run_*.py and DSS paths are found (Colab/local)\n",
    "# Original dataset run logs first 20 non-converged (ControlIterations). Set os.environ['DEBUG_VOLTVAR']='0' to disable.\n",
    "try:\n",
    "    import run_injection_dataset as _inj\n",
    "    os.chdir(os.path.dirname(os.path.abspath(_inj.__file__)))\n",
    "except Exception:\n",
    "    pass\n",
    "exec(open(\"run_original_dataset.py\", encoding=\"utf-8\").read())\n"
